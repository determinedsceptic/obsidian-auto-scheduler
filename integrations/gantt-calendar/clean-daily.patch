+++ b/tests/dailyNoteIntervals.test.ts
@@ -0,0 +1,32 @@
+import { TFile, ListItemCache } from 'obsidian';
+import { parseTasksFromListItems } from '../src/tasks/taskParser/main';
+import { updateTaskProperties } from '../src/tasks/taskUpdater';
+const path = 'DailyNotes/2026-10-04.md';
+function read(content: string, name = path) {
+ const lines = content.split('\n');
+ const items = lines.flatMap((line, i) => /^- \[.\]/.test(line) ? [{ position: {start:{line:i,col:0,offset:0},end:{line:i,col:line.length,offset:line.length}},task:line[3]} as ListItemCache] : []);
+ return parseTasksFromListItems({path:name,basename:name.split('/').pop()!.replace('.md','')},lines,items,['tasks','dataview'],'');
+}
+describe('clean daily intervals', () => {
+ it('indexes all five daily tasks; preserves deadline, priority and completion', () => {
+  const tasks = read('# Day planner\n- [x] 12:40 - 13:10 🔼 午餐后快走 ✅ 2026-10-04\n- [x] 18:40 - 19:10 🔼 晚餐后快走 ✅ 2026-10-04\n- [ ] 09:00 - 09:30 ⏫ 🎯 入党申请书 📅 2026-10-20\n- [ ] 09:45 - 10:15 🔼 Website\n- [ ] 10:30 - 11:00 🔼 Book');
+  expect(tasks).toHaveLength(5); expect(tasks.every(t=>t.dailyNoteInterval)).toBe(true);
+  expect(tasks[0].startDate?.getHours()).toBe(12); expect(tasks[0].scheduledDate?.getMinutes()).toBe(10);
+  expect(tasks[0].completed).toBe(true); expect(tasks[0].description).toBe('午餐后快走');
+  expect(tasks[2].dueDate?.getDate()).toBe(20); expect(tasks[2].startDate?.getDate()).toBe(4); expect(tasks[2].priority).toBe('high');
+ });
+ it('preserves explicit date fields and excludes non-daily/fenced rows', () => {
+  expect(read('# Day planner\n- [ ] 09:00 - 10:00 Task 🛫 2026-10-08')[0].startDate?.getDate()).toBe(8);
+  expect(read('# Day planner\n- [ ] 09:00 - 10:00 Task','Habits/Walk.md')[0].dailyNoteInterval).toBeUndefined();
+  expect(read('# Day planner\n```\n- [ ] 09:00 - 10:00 Example\n```')[0].dailyNoteInterval).toBeUndefined();
+ });
+ it('completion/reopening preserves clean text; inferred fields are not serialized', async () => {
+  const source = '# Day planner\n- [ ] 09:00 - 09:30 ⏫ 🎯 Task 📅 2026-10-20\n'; let text = source;
+  const file = new TFile(); file.path = path;
+  const app = {vault:{getAbstractFileByPath:()=>file,read:async()=>text,process:async (_f:TFile,fn:(s:string)=>string)=>{text=fn(text);}},plugins:{getPlugin:()=>null}} as unknown as Parameters<typeof updateTaskProperties>[0];
+  await updateTaskProperties(app,read(text)[0],{completed:true,status:'done',completionDate:new Date(2026,9,4)},['tasks','dataview']);
+  expect(text).toBe(source.replace('[ ]','[x]').replace('2026-10-20','2026-10-20 ✅ 2026-10-04'));
+  await updateTaskProperties(app,read(text)[0],{completed:false,status:'todo',completionDate:null},['tasks','dataview']); expect(text).toBe(source);
+  await expect(updateTaskProperties(app,read(text)[0],{startDate:new Date(2026,9,5,9)},['tasks','dataview'])).rejects.toThrow('daily note'); expect(text).toBe(source);
+ });
+});
