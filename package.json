{
  "name": "obsidian-auto-scheduler",
  "version": "0.6.0",
  "private": true,
  "description": "Local, preview-first scheduling for Markdown tasks",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run.mjs test",
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "demo": "node scripts/run.mjs demo",
    "package": "npm run build && node scripts/package.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "release:check": "npm run build && node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.6.6",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "4.1.11"
  },
  "overrides": {
    "moment": "2.31.0"
  },
  "type": "module",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "license": "MIT",
  "author": "Alex Hu",
  "repository": {
    "type": "git",
    "url": "https://github.com/determinedsceptic/obsidian-auto-scheduler.git"
  },
  "bugs": {
    "url": "https://github.com/determinedsceptic/obsidian-auto-scheduler/issues"
  },
  "homepage": "https://github.com/determinedsceptic/obsidian-auto-scheduler#readme"
}
